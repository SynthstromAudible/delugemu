+#define SD_RA_SIZE (64 * KiB)
+
+/* Fill the read-ahead buffer from addr. Returns false if that fails. */
+static bool sd_ra_fill(SDState *sd, uint64_t addr, uint32_t len)
+{
+    int64_t end = blk_getlength(sd->blk);
+    uint32_t ra_len;
+
+    if (end <= 0 || addr + len > end) {
+        return false;
+    }
+    ra_len = MIN(SD_RA_SIZE, end - addr);
+    if (!sd->ra_buf) {
+        sd->ra_buf = g_malloc(SD_RA_SIZE);
+    }
+    sd->ra_len = 0;
+    if (blk_pread(sd->blk, addr, ra_len, sd->ra_buf, 0) < 0) {
+        return false;
+    }
+    sd->ra_addr = addr;
+    sd->ra_len = ra_len;
+    return true;
+}
+
 static void sd_blk_read(SDState *sd, uint64_t addr, uint32_t len)
 {
     trace_sdcard_read_block(addr, len);
     addr += sd_part_offset(sd);
+    if (sd->blk && len <= SD_RA_SIZE) {
+        bool hit = sd->ra_len && addr >= sd->ra_addr &&
+                   addr + len <= sd->ra_addr + sd->ra_len;
+
+        if (hit || sd_ra_fill(sd, addr, len)) {
+            memcpy(sd->data, sd->ra_buf + (addr - sd->ra_addr), len);
+            return;
+        }
+    }
     if (!sd->blk || blk_pread(sd->blk, addr, len, sd->data, 0) < 0) {
         fprintf(stderr, "sd_blk_read: read error on host side\n");
     }
