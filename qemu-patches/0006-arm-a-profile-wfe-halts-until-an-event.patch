+bool arm_cpu_exec_interrupt(CPUState *cs, int interrupt_request)
+{
+    CPUARMState *env = cpu_env(cs);
+    uint32_t excp_idx;
+    uint32_t target_el;
+
+    if (!arm_cpu_select_interrupt(cs, interrupt_request,
