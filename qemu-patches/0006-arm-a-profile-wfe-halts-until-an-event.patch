+bool arm_cpu_wfe_wakeup_pending(CPUState *cs);
+
+/**
+ * arm_wfe_can_halt(): True if WFE on this CPU suspends execution until a
+ * WFE wake-up event, as the architecture describes, rather than yielding.
+ *
+ * This is the ARMv7-A/R model (event register set by SEV and by exception
+ * return; woken by SEV or an unmasked IRQ/FIQ/asynchronous abort).
+ * M-profile has its own handling. ARMv8 is excluded because it also sets
+ * the event register when the global exclusive monitor is cleared, which
+ * QEMU does not model; halting there could sleep through a release that
+ * software (e.g. Linux's LDAXR/WFE wait loops) relies on to wake it.
+ */
+static inline bool arm_wfe_can_halt(CPUARMState *env)
+{
+    return arm_feature(env, ARM_FEATURE_V7)
+        && !arm_feature(env, ARM_FEATURE_V8)
+        && !arm_feature(env, ARM_FEATURE_M);
+}
